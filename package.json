{
  "name": "dsh-device-fleet",
  "version": "0.4.0",
  "private": false,
  "type": "module",
  "description": "DSH fleet plugin: a controller DSH drives worker DSH instances over the LAN through GUI-parity session APIs.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.png",
    "icon.svg",
    "README.md",
    "assets/miniatures/*.png",
    "assets/miniatures/prompts.json"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  }
}
