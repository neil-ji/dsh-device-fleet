{
  "name": "dsh-device-fleet",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "DSH fleet plugin: a controller DSH drives worker DSH instances over the LAN through GUI-parity session APIs.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "index.js",
    "lib/server.js",
    "lib/client.js",
    "lib/tools.js",
    "lib/credentials.js",
    "lib/discovery.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  }
}
